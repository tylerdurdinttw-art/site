# ============================================================
#  Обязательное
# ============================================================

# PostgreSQL
DATABASE_URL="postgresql://ynazicottv:ynazicottv@localhost:5432/ynazicottv?schema=public"

# Ключ подписи кук сессий. Минимум 32 символа, свой на каждом сервере.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Смена ключа разлогинивает всех.
AUTH_SECRET=""

# Внешний адрес панели. Из него собираются ссылки в письмах, а https
# включает флаг Secure у куки сессии.
APP_URL="http://localhost:3000"

# ============================================================
#  Почта: письмо с подтверждением при регистрации
#  Пока SMTP_HOST пуст, письма не уходят — ссылка печатается в лог сервера
#  и показывается прямо в интерфейсе после регистрации.
# ============================================================

SMTP_HOST=""
SMTP_PORT="587"
# Пусто — определяется по порту: 465 = true, остальные = false (STARTTLS).
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="QuickPanel <no-reply@example.com>"

# "false" закрывает регистрацию новых учёток. Первую заводят всегда,
# даже при закрытой регистрации — иначе в панель было бы не войти.
SIGNUP_OPEN="true"

# ============================================================
#  Необязательное
# ============================================================

# MaxMind GeoLite2 — локальные .mmdb файлы (внешний API не используется).
# Скачиваются вручную с maxmind.com и кладутся в ./geoip
GEOLITE2_CITY_DB="./geoip/GeoLite2-City.mmdb"
GEOLITE2_ASN_DB="./geoip/GeoLite2-ASN.mmdb"

# Кеш ip_info, дней
IP_INFO_TTL_DAYS="30"

# Дополнительные подстроки для признака VPN в названии организации ASN, через запятую.
# Базовый список хостингов и VPN-сервисов зашит в src/lib/vpn.ts.
VPN_ASN_KEYWORDS=""

# Steam Web API — часы в Rust и блокировки VAC/EAC в карточке игрока.
# Ключ берётся на steamcommunity.com/dev/apikey.
# ОБЯЗАТЕЛЕН для значка VAC: без ключа панель не знает про блокировки и честно
# пишет «Steam не ответил», а значок не показывает вовсе.
STEAM_API_KEY="0FFDB660570007CA58721C5BA63CCC2C"

# Кеш steam_profiles, часов
STEAM_CACHE_TTL_HOURS="12"

# rustmaps.com — карта ищется по seed и размеру мира.
# Ключ берётся в личном кабинете rustmaps.com -> Dashboard -> API keys.
# Без ключа панель падает на запасной рельеф, снятый плагином.
RUSTMAPS_API_KEY=""

# Окно приёма запросов от плагина по X-Timestamp, секунд
INGEST_MAX_SKEW_SEC="60"

# Rate-limit ingest-эндпоинтов, запросов в минуту на сервер
INGEST_RATE_LIMIT_PER_MIN="60"

# Redis (опционально). Если не задан — используется in-memory реализация.
# REDIS_URL="redis://localhost:6379"
